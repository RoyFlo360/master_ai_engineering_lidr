# LLM Provider configuration
# Supported providers: deepseek | anthropic
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash

# DeepSeek is consumed through an OpenAI-compatible API: set DEEPSEEK_API_KEY,
# or reuse the OPENAI_API_KEY slot for the same credential.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Conversational sessions (Session 5)
# Per-attachment cap on extracted text (characters). 60_000 so the stress
# corpus's 50 KB point sits under the cap and its 100 KB point truncates.
MAX_ATTACHMENT_CHARS=60000
MAX_CONVERSATION_TURNS=6
# Metadata is refreshed heuristically; the LLM extractor runs only when the
# heuristic finds no project name / team size / technology for the turn.
METADATA_LLM_FALLBACK=true
METADATA_EXTRACTOR_MODEL=gpt-4o-mini
# Fallback model for the auxiliary calls (metadata extractor, summarizer, critic,
# anchor classifier). Retried once when the primary aux model fails (e.g. the
# OpenAI provider has no credits). Leave empty to disable.
AUX_FALLBACK_MODEL=deepseek/deepseek-flash

# Session 6 — hybrid memory compression, dynamic audience tier, Actor-Critic-Boss
# Anchor detector: ``heuristic`` (regex, no LLM cost) or ``llm`` (classifier).
ANCHOR_DETECTION_MODE=heuristic
# Cheap model for the cumulative conversation summarizer.
COMPRESSION_MODEL=gpt-4o-mini
# Conversational prompt version: v2 is the Session-5 baseline, v3 adds the
# <audience> tier block and the optional <critic_feedback> block.
CONVERSATIONAL_PROMPT_VERSION=v3
# Critic model for the Actor-Critic-Boss audit; a small model is enough.
CRITIC_MODEL=gpt-4o-mini
# Boss iterations: 1 initial draft + directed retries (each = actor + critic).
BOSS_MAX_ITERATIONS=3

# Semantic cache: needs OPENAI_API_KEY (embeddings) and a Redis with RediSearch
# (image redis/redis-stack). On vanilla redis:7-alpine it degrades to a no-op.
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_LOG_ONLY=false

# Session 7 (extension) — data ingestion
# Default DATABASE_URL is a SQLite file at <repo>/var/estimator.db so tests and a
# laptop run need no database. docker-compose overrides it with Postgres.
# Uncomment to point at a Postgres instance manually (compose maps 5433 on the host):
# DATABASE_URL=postgresql+psycopg://estimator:estimator@localhost:5433/estimator
#
# The shipped catalog and seed corpus are resolved from the project root by default;
# override only if you keep them elsewhere.
# CATALOG_PATH=data/catalog/catalog.yaml
# INGESTION_DATA_ROOT=data/seed
#
# PII: "auto" uses Presidio when the Spanish spaCy model is available and falls
# back to regex otherwise. The model (es-core-news-md) is a declared dependency,
# so `uv sync` installs it; nothing extra to download. Use "presidio" to fail
# closed instead of degrading, or "regex" to skip spaCy entirely.
PII_ANALYZER_MODE=auto
PRESIDIO_SPACY_MODEL=es_core_news_md
PSEUDONYM_FAKER_LOCALE=es_ES
# HMAC salt for pseudonym mappings. Rotating it invalidates every prior mapping.
# CHANGE IN PRODUCTION.
PSEUDONYM_HASH_SALT=change-me-in-prod

# Session 10 — hybrid search (vector + full-text, fused with RRF) and reranking.
# The Postgres text-search configuration (`english`) is NOT a setting: it is a code
# constant, `FTS_REGCONFIG`, in `app/embedding_pipeline/store/repository.py`, and
# the migration's generated column hard-codes the same literal. They must agree, so
# it is deliberately not overridable from here — a drifting .env value would
# bypass the GIN index without failing anything.
# Default retrieval mode: ``vector`` (pre-Session-10 behaviour) or ``hybrid``.
RETRIEVAL_SEARCH_MODE=vector
# Reciprocal Rank Fusion constant; larger means both branches must agree.
RRF_K=60
# Recall-then-rerank width: candidates fetched before the cross-encoder runs.
RETRIEVAL_RECALL_TOP_K=50
# How many chunks survive the reranker.
RERANK_TOP_N=5
# Reranking is opt-in: the model is a ~120 MB download, keep the cheap path cheap.
RERANKER_ENABLED=false
# Multilingual (ES+EN) cross-encoder, small enough to run on CPU.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Cosine-distance floor applied by the grounded-estimation chain (NOT by
# /v1/retrieval/search, which returns the nearest chunks whatever the distance).
# Above this, the chain reports grounded=false instead of estimating from
# irrelevant budgets. Calibrated on the 60-chunk corpus: relevant queries land at
# 0.43-0.60, an unrelated topic at 0.71-0.72. Re-tune if the embedding model or
# the chunk template changes.
RETRIEVAL_DISTANCE_THRESHOLD=0.65
