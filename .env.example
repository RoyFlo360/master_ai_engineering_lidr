# LLM Provider configuration
# Supported providers: deepseek | anthropic
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash

# DeepSeek is consumed through an OpenAI-compatible API: set DEEPSEEK_API_KEY,
# or reuse the OPENAI_API_KEY slot for the same credential.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=DEBUG
